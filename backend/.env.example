# RoomGenius AI — Backend Environment Template
# Copy this file to backend/.env (do NOT commit backend/.env to Git)

# 1. Official Meta Model API (Day 5 & 6)
META_API_KEY="LLM_your_official_meta_api_key_here"
META_BASE_URL="https://api.meta.ai/v1"
META_MODEL="muse-spark-1.3"

# 2. Local Testing & Credit Conservation
# Set to true to force deterministic mock explanations without making network calls
MOCK_AI="false"

# 3. Optional Historical Fallback (Baseten)
BASETEN_API_KEY="your_baseten_api_key_here"
BASETEN_BASE_URL="https://inference.baseten.co/v1"
BASETEN_MODEL="meta-models/muse-spark-open"

