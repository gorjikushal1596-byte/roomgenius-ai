# OmniRoute Local Environment Template for RoomGenius AI
# Copy this file to .env.local (do NOT commit .env.local to Git)

# 1. Local OmniRoute Gateway Configuration
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
OPENAI_BASE_URL="http://localhost:20128/v1"

# 2. OmniRoute Authentication Key (Retrieve from your local OmniRoute UI/CLI)
OMNIROUTE_API_KEY="your-omniroute-api-key-here"
OPENAI_API_KEY="your-omniroute-api-key-here"

# 3. Confirmed RoomGenius AI Multi-Agent Model Assignments
MODEL_AGENT_1_ARCHITECT="openai/gpt-oss-120b"
ROUTE_AGENT_1_ARCHITECT="groq/openai/gpt-oss-120b"

MODEL_AGENT_2_CODER="qwen/qwen3.8-27b"
ROUTE_AGENT_2_CODER="groq/qwen/qwen3.8-27b"

MODEL_AGENT_3_FAST="openai/gpt-oss-20b"
ROUTE_AGENT_3_FAST="groq/openai/gpt-oss-20b"

MODEL_AGENT_4_DEBUG="gemini-3.1-flash-lite"
ROUTE_AGENT_4_DEBUG="gemini-provider-direct"

# 4. Strict Model Guardrails
# DISALLOWED MODELS: Kimi K2 Thinking, Qwen3 Coder Plus, Qwen3 Coder Flash, DeepSeek R1
